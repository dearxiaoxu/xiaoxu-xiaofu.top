# 站点 Nginx 反向代理配置（ICP 备案完成后使用）
# 复制到 /etc/nginx/conf.d/xiaoxu-xiaofu.conf，把域名与证书路径换成你自己的

# HTTP：统一跳转 HTTPS
server {
    listen 80;
    listen [::]:80;
    server_name xiaoxu-xiaofu.top www.xiaoxu-xiaofu.top;
    return 301 https://$host$request_uri;
}

# HTTPS：反代到本地 Node 服务（默认 3000 端口）
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name xiaoxu-xiaofu.top www.xiaoxu-xiaofu.top;

    # 证书路径（用 certbot 自动签发后按实际路径填写）
    ssl_certificate     /etc/letsencrypt/live/xiaoxu-xiaofu.top/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/xiaoxu-xiaofu.top/privkey.pem;

    # 上传接口最大 16MB（base64 图片）
    client_max_body_size 16m;

    # 静态资源缓存（html/js/css 由后端控制 no-cache）
    location /uploads/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        expires 7d;
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
